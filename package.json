{
  "name": "air",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run typecheck && npm run verify:build",
    "dev": "vercel dev",
    "start": "vercel dev",
