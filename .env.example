# Air — names and placeholders only. Never commit populated values.
# This file describes the current dark Vercel deployment. Do not copy its
# placeholder values into an active environment without replacing every value.

# Existing Photon / Spectrum project. Required before signed ingress can be
# acknowledged; do not configure the upstream webhook during dark deployment.
IMESSAGE_PROJECT_ID=replace_with_existing_project_id
IMESSAGE_PROJECT_SECRET=replace_with_existing_project_secret
IMESSAGE_WEBHOOK_SECRET=replace_with_existing_webhook_signing_secret

# Existing Redis only. The HTTPS REST pair is preferred for Vercel serverless;
# REDIS_URL is the validated fallback when the REST pair is absent.
UPSTASH_REDIS_REST_URL=https://replace_with_existing_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=replace_with_existing_upstash_rest_token
REDIS_URL=rediss://replace_with_existing_redis_url

# Privacy and durable queue encryption. Sender hashes are lowercase
# HMAC-SHA256 digests, never phone numbers or Apple IDs.
AIR_ID_HASH_SECRET=replace_with_random_hmac_secret
AIR_QUEUE_ENCRYPTION_KEY=replace_with_base64_32_byte_aes_256_gcm_key
AIR_ALLOWED_SENDER_HASHES=replace_with_64_character_lowercase_hex_hmac

# Public and operator paths.
AIR_PUBLIC_BASE_URL=https://air.wzrd.tech
CRON_SECRET=replace_with_random_operator_secret

# Immutable registry contract. The committed 2.1.0 registry has zero enabled
# models, so it cannot create billable work.
AIR_MODEL_REGISTRY_VERSION=2.1.0
AIR_DAILY_USER_JOB_LIMIT=3
AIR_ACTIVE_JOB_LIMIT=1

# Dark-deployment kill switches: every value must remain explicitly false.
AIR_RELEASE_PHASE=dark
AIR_ACCEPT_NEW_JOBS=false
AIR_ALLOW_PROVIDER_SUBMIT=false
AIR_ALLOW_PROVIDER_RECOVERY=false
AIR_DELIVERY_ENABLED=false
AIR_JOB_SPEND_CAP_USD=0
AIR_DAILY_SPEND_CAP_USD=0
AIR_CANARY_TOTAL_CAP_USD=0
AIR_CANARY_FAL_CAP_USD=0

# Leave absent in dark deployment. These are considered only after a separate
# Fable approval authorizes catalog verification and a bounded canary.
# GMI_API_KEY=replace_only_after_approval
# GMI_ORG_ID=optional_organization_identifier
# AIR_CANARY_BUDGET_ID=approved_budget_identifier
