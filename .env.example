# Air / AR Agent — placeholders only. Never commit a populated .env file.
# Production secrets belong only in Vercel Production; preview must use separate
# signed fixtures and a separate read-only Atlas identity.

# Photon / Spectrum Cloud (required)
IMESSAGE_PROJECT_ID=a26b448c-9bd6-4469-847a-84b78c1f7778
IMESSAGE_PROJECT_SECRET=replace_with_photon_project_secret
IMESSAGE_WEBHOOK_SECRET=replace_with_photon_webhook_signing_secret
IMESSAGE_USERNAME=AR Agent

# Redis: durable Chat SDK state, encrypted inbox/outbox, locks, and limits
REDIS_URL=redis://localhost:6379

# Existing read-only MusicRAG corpus
MONGODB_URI=mongodb+srv://air_readonly:replace_me@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=music_rag
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_CONNECT_TIMEOUT_MS=8000

# Retrieval and generation
VOYAGE_API_KEY=replace_with_voyage_api_key
EMBED_MODEL=voyage-4-large
RERANK_MODEL=rerank-2.5
GENERATION_MODEL=google/gemini-3.5-flash
# Optional locally only. Production on Vercel uses OIDC for AI Gateway.
AI_GATEWAY_API_KEY=

# Privacy and durable-message security
AIR_ID_HASH_SECRET=replace_with_random_hmac_secret
# Comma-separated HMAC-SHA256 sender hashes. Production fails closed when empty.
AIR_ALLOWED_SENDER_HASHES=replace_with_64_char_lowercase_hex_hmac
# Base64-encoded random 32-byte AES-256-GCM key.
AIR_QUEUE_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Public routes and operator recovery
AIR_PUBLIC_BASE_URL=https://air.wzrd.tech
CRON_SECRET=replace_with_random_operator_secret
