# Air — placeholders only. Never commit a populated .env file.
# Production values belong only in Vercel Production. Keep preview credentials
# separate from the real iMessage project and Zap production service.

# Photon / Spectrum Cloud (required for signed ingress and iMessage delivery)
IMESSAGE_PROJECT_ID=replace_with_photon_project_id
IMESSAGE_PROJECT_SECRET=replace_with_photon_project_secret
IMESSAGE_WEBHOOK_SECRET=replace_with_photon_webhook_signing_secret

# Upstash Redis: encrypted inbox, durable video jobs, locks, and limits.
REDIS_URL=rediss://replace_with_upstash_redis_url

# Private Zap video-service boundary. Air never receives GMI credentials.
ZAP_AIR_SERVICE_URL=https://zap.wzrd.tech
ZAP_AIR_SERVICE_TOKEN=replace_with_random_air_to_zap_service_token

# Privacy and durable-message security
AIR_ID_HASH_SECRET=replace_with_random_hmac_secret
# Comma-separated HMAC-SHA256 sender hashes. Production fails closed when empty.
AIR_ALLOWED_SENDER_HASHES=replace_with_64_char_lowercase_hex_hmac
# Base64-encoded random 32-byte AES-256-GCM key.
AIR_QUEUE_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Public routes and operator recovery
AIR_PUBLIC_BASE_URL=https://air.wzrd.tech
CRON_SECRET=replace_with_random_operator_secret
